# Copy to .env and fill in. Settings are read by app/core/config.py.

# --- App ---
APP_NAME=Paylancer
# development | staging | production. Production refuses weak/default secrets.
APP_ENV=development
DEBUG=false
API_V1_STR=/api/v1

# --- Security ---
# Random, >= 32 chars in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Fernet key for encrypted columns. Required (and valid) in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/paylancer

# --- Client portal / invoicing ---
# Public URL of the web client; used to build links in outgoing emails.
FRONTEND_URL=http://localhost:3000
# Public URL of this API; used for token-based PDF links shared with clients.
BACKEND_URL=http://localhost:8000
PORTAL_TOKEN_EXPIRE_DAYS=14
# Minimum seconds between last_used_at writes for one portal token.
PORTAL_TOKEN_TOUCH_INTERVAL_SECONDS=60
DEFAULT_PAYMENT_TERMS_DAYS=30
INVOICE_NUMBER_PREFIX=INV
# Minimum gap between reminders to the same client.
INVOICE_REMINDER_MIN_INTERVAL_HOURS=24

# --- Outgoing email ---
# console only logs; smtp delivers (needs SMTP_HOST and SMTP_FROM).
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true: implicit TLS on 465, STARTTLS otherwise. false: plain (Mailpit).
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# --- Rate limiting ---
# Full data export (POST /export): attempts allowed per user per window.
EXPORT_RATE_LIMIT=3
EXPORT_RATE_WINDOW_SECONDS=3600
# Auth (/auth/login, /auth/register): attempts per window, per client IP and per email.
AUTH_RATE_LIMIT_PER_IP=10
AUTH_RATE_LIMIT_PER_EMAIL=5
AUTH_RATE_WINDOW_SECONDS=900
# Client portal endpoints: requests per window per client IP.
PORTAL_RATE_LIMIT=120
PORTAL_RATE_WINDOW_SECONDS=60
# Header carrying the real client IP behind a reverse proxy (e.g. X-Forwarded-For).
# Leave empty to ignore forwarding headers; only set it when a proxy you control
# overwrites that header.
TRUSTED_PROXY_HEADER=

# --- Request limits ---
# Requests with a larger body are refused with 413.
MAX_REQUEST_BODY_BYTES=1048576
# Upper bound for the `limit` query parameter on list endpoints.
MAX_PAGE_SIZE=100

# --- Exchange rates (display-only, never used in totals) ---
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_MAX_AGE_HOURS=24
FX_CURRENCIES=PKR,EUR,GBP,AED
FX_AUTO_FETCH=true

# --- CORS / hosts ---
# Comma-separated or JSON array.
CORS_ORIGINS=http://localhost:3000
# Required in production (TrustedHostMiddleware).
ALLOWED_HOSTS=

# --- First superuser (seeded on first run) ---
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=
